# Copier en .env (ignoré par Git) et remplacer les valeurs. Ne jamais committer .env.
# Fusionner avec votre .env.example existant si d autres variables y figurent.

APP_ENV=local
SQLITE_PATH=database/luxury_stock_pipeline.sqlite

# PostgreSQL (docker compose)
POSTGRES_DB=luxury_stock
POSTGRES_USER=luxury_stock
POSTGRES_PORT=5432
POSTGRES_PASSWORD=changez-moi
# Mots de passe des rôles de connexion créés par 004_roles.sql
LUXURY_APP_PASSWORD=changez-moi
LUXURY_PIPELINE_PASSWORD=changez-moi
